{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnoughWork",
  "version": "0.2.0",
  "identifier": "com.mtsandeep.enoughwork",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EnoughWork",
        "width": 640,
        "height": 560,
        "minWidth": 480,
        "minHeight": 440,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mtsandeep/enoughwork/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1N0QxNTRDRkQwOEQ2NkYKUldSdjFnajlUQlY5SlJidkc4Y2puU0c5Nnhqek5VaitsVDh4bkJoMFRDVVNGR3kvY05LRlVJWG0K"
    }
  }
}
