{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnoughWork",
  "version": "0.1.2",
  "identifier": "com.mtsandeep.enoughwork",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EnoughWork",
        "width": 640,
        "height": 560,
        "minWidth": 480,
        "minHeight": 440,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
